# Local development: leave empty to use the Vite proxy to the backend at localhost:3000.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:3000

# Production: set VITE_API_BASE_URL in your frontend hosting provider to the deployed backend origin.
# Example only (replace with your actual backend deployment URL):
# VITE_API_BASE_URL=https://your-backend-project.vercel.app
